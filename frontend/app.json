{
  "expo": {
    "name": "CarAgencyMobile",
    "slug": "CarAgencyMobile",
    "version": "1.0.0",
    "scheme": "caragencymobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["comgooglemaps", "googlechromes", "google.navigation"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vijayrajvj.CarAgencyMobile",
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": [{ "scheme": "google.navigation" }],
          "category": ["android.intent.category.DEFAULT", "android.intent.category.BROWSABLE"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      "@rnmapbox/maps"
    ],
    "extra": {
      "eas": {
        "projectId": "c7e345e5-c776-46af-997a-dc3f2823c768"
      }
    }
  }
}
