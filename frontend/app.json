{
  "expo": {
    "name": "CarAgencyMobile",
    "slug": "CarAgencyMobile",
    "version": "1.0.0",
    "scheme": "caragencymobile",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.vijayrajvj.CarAgencyMobile",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "googlechromes",
          "google.navigation"
        ],
        "NSLocationWhenInUseUsageDescription": "We need your location to find nearby drivers and track your ride.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Driver mode needs background location to share live trip updates.",
        "NSCameraUsageDescription": "Camera is used to capture your profile photo and driver documents (car, licence, RC).",
        "NSPhotoLibraryUsageDescription": "Photo library is used to upload your profile photo and driver documents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vijayrajvj.CarAgencyMobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "data": [
            {
              "scheme": "google.navigation"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access photos for profile and driver documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vazhi uses your location to set your pickup point and show nearby cabs.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find rides and track trips."
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "c7e345e5-c776-46af-997a-dc3f2823c768"
      }
    }
  }
}
