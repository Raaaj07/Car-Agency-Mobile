# Frontend (Expo) environment — variable NAMES ONLY, never commit real values.
# Copy to `.env` (gitignored) and fill in. EXPO_PUBLIC_* values are inlined at
# build time, so treat them as public (no secrets here).
# Guarded by .githooks/pre-commit and .github/workflows/secrets-guard.yml.

# Base URL of the API — must end in /api/v1 (physical device needs your LAN IP).
EXPO_PUBLIC_API_URL=

# Mapbox (address search, routes, map rendering).
EXPO_PUBLIC_MAPBOX_TOKEN=

# Google sign-in + places.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_PLACE=
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# Support contacts shown on Help & support (public). REQUIRED for a release build:
# without them the screen shows no phone/email (development builds show placeholders).
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Legal pages linked from the sign-in screen (public https URLs). Google Play and the App
# Store both require a working privacy-policy link; without them the words are plain text.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
