# Backend environment — variable NAMES ONLY, never commit real values.
# Copy to `.env` (gitignored) and fill in every line. Empty values fail
# startup/validation on purpose. Secrets: generate with `openssl rand -base64 48`.
# Guarded by .githooks/pre-commit and .github/workflows/secrets-guard.yml.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
API_PREFIX=api/v1
CORS_ORIGIN=
PUBLIC_API_URL=
# SEC-5: true ONLY behind a reverse proxy (Render/nginx) so rate limiting and
# audit logs see real client IPs instead of the proxy address. Leave false
# when the port is directly reachable — a spoofable X-Forwarded-For would
# then mint a fresh rate-limit bucket per request. Production logs a warning
# when this is false (Render should set it to true).
TRUST_PROXY=false

# ── Postgres (required) ──────────────────────────────────────────────────────
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ── Redis (required) ─────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── Auth / JWT (required, >= 32 chars) ───────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── OTP / SMS (AU-1 send limits, SEC-1 lockout) ──────────────────────────────
OTP_TTL_SECONDS=300
# Code width, 4..8 (matches VerifyOtpDto). SEC-1: leave at 4 until an app
# build that renders the server-reported otpLength boxes is shipped, then set
# 6 in production — OTP-login admin promotion refuses codes shorter than 6.
OTP_LENGTH=4
OTP_DEV_MODE=false
OTP_SEND_MAX=3
OTP_SEND_WINDOW_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=

# ── Payments ─────────────────────────────────────────────────────────────────
PAYMENTS_DEV_MODE=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Social sign-in / places ──────────────────────────────────────────────────
GOOGLE_WEB_CLIENT_ID=
APPLE_CLIENT_ID=
GOOGLE_PLACES_API_KEY=

# ── Admin console ────────────────────────────────────────────────────────────
# Comma-separated E.164 phone numbers promoted to role=admin.
ADMIN_PHONES=

# ── Uploads / storage ────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vazhi
CLOUDINARY_SIGNED_URL_TTL_SECONDS=600

# ── Rides / geo ──────────────────────────────────────────────────────────────
DRIVER_SEARCH_RADIUS_METERS=5000
DRIVER_LOCATION_STALE_SECONDS=90
RIDE_REQUEST_TIMEOUT_SECONDS=15
RIDE_SEARCH_TIMEOUT_SECONDS=90

# ── Routing (Task 4: RouteDistanceService) ───────────────────────────────────
# Mapbox Directions API token; falls back to straight-line x1.3 when unset.
MAPBOX_TOKEN=

# ── Timezone (R-6: day boundaries for earnings + admin stats) ────────────────
APP_TIMEZONE=Asia/Kolkata

# ── Local seed script (`npm run seed`) ───────────────────────────────────────
SEED_CITY_NAME=Salem, Tamil Nadu
SEED_CITY_LAT=11.6643
SEED_CITY_LNG=78.1460
SEED_SPREAD_KM=6
SEED_DRIVER_COUNT=40
